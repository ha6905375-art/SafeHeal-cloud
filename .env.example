# Copy this file to .env (same folder) and fill in your own values.
# .env is gitignored. Never commit a real API key.

# Nebius Token Factory API key (from your Nebius account)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Model ID available to your key. List them with: python -m ai.check_connection
NEBIUS_MODEL=

# AI integration options (see ai/README.md)
# mock = no API calls, no credits (default). live = real Nebius requests.
AI_MODE=mock
NEBIUS_TIMEOUT_SECONDS=60
NEBIUS_MAX_RETRIES=2
# Default 16384. At 4096 the Nemotron reply was cut off and rejected; completed live
# replies (test/live-monitor-ai branch) used about 5,300-5,500 completion tokens.
NEBIUS_MAX_OUTPUT_TOKENS=16384
# json_object (default) or none, if the chosen model rejects JSON mode
NEBIUS_JSON_MODE=json_object
# Internet-facing SafeHeal public website needs a separate strong TEAM password:
# SAFEHEAL_DEMO_PASSWORD=  (required in the server's environment, 12+ characters)
# SAFEHEAL_DEMO_USERNAME=demo
#
# Optional judge-only access: configure BOTH in the server environment.
# The judge username must differ from the team username; password 16+ characters.
# Judges can only unlock and run the bundled synthetic Nebius demonstration.
# SAFEHEAL_JUDGE_USERNAME=
# SAFEHEAL_JUDGE_PASSWORD=
# SAFEHEAL_ALLOW_LIVE_DEMO=false
# See JUDGING_ACCESS.md and DEPLOY_RENDER.md for safeguards.
#
# Live Attack Monitoring authentication
# Set a strong, private token in your local .env file.
# Never commit the real token to GitHub.
LIVE_EVENTS_API_TOKEN=